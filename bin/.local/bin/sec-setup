#!/usr/bin/env bash
# sec-setup - scoped AIDE + targeted auditd

[ "$EUID" -eq 0 ] || exec sudo "$0" "$@"
set -euo pipefail

U="${SUDO_USER:?run as your normal user (it calls sudo itself)}"
H="$(getent passwd "$U" | cut -d: -f6)"
S=/var/lib/sec-status
AIDE_CONF=/etc/aide/local.conf
AIDE_DB=/var/lib/aide-local/aide.db.gz

echo "[+] packages"
apt-get install -y -qq --no-install-recommends aide auditd >/dev/null
install -d -m 0755 "$S" /var/lib/aide-local /var/log/aide-local
# mute alert collector during setup
echo 9999999999 >"$S/audit.last"

# ---------------------------------------------------------------- AIDE
echo "[+] AIDE config"
cat >"$AIDE_CONF" <<EOF
database_in=file:$AIDE_DB
database_out=file:/var/lib/aide-local/aide.db.new.gz
gzip_dbout=yes
report_url=stdout

SYS = p+i+n+u+g+s+m+c+sha256

/boot          SYS
/etc           SYS
/usr/bin       SYS
/usr/sbin      SYS
/usr/lib       SYS
/usr/libexec   SYS
/usr/local     SYS
/root/.ssh     SYS
$H/.ssh/authorized_keys  SYS
$H/.config/autostart     SYS
$H/.config/systemd/user  SYS

!/etc/mtab
!/etc/adjtime
!/etc/cups
!/etc/.*~
EOF

systemctl disable --now dailyaidecheck.timer >/dev/null 2>&1 || true

cat >/usr/local/sbin/aide-check <<'EOF'
#!/usr/bin/env bash
# daily AIDE check
OUT=/var/log/aide-local/check-$(date +%F_%H%M).log
aide -c /etc/aide/local.conf --check >"$OUT" 2>&1
rc=$?
if [ $rc -eq 0 ]; then s=ok; elif [ $rc -lt 14 ]; then s=CHANGED; else s=ERROR; fi
echo "$s $(date +%F_%H:%M) $OUT" >/var/lib/sec-status/aide
chmod 0644 /var/lib/sec-status/aide
find /var/log/aide-local -name 'check-*.log' -mtime +30 -delete
EOF

cat >/usr/local/sbin/aide-accept <<'EOF'
#!/usr/bin/env bash
# accept current state as AIDE baseline
nice -n 19 ionice -c3 aide -c /etc/aide/local.conf --update >/dev/null 2>&1
rc=$?
[ $rc -ge 14 ] && { echo "[-] aide --update failed (rc=$rc)"; exit 1; }
mv -f /var/lib/aide-local/aide.db.new.gz /var/lib/aide-local/aide.db.gz
echo "ok $(date +%F_%H:%M) accepted" >/var/lib/sec-status/aide
echo "[+] AIDE baseline updated"
EOF

cat >/etc/systemd/system/aide-check.service <<'EOF'
[Unit]
Description=AIDE integrity check

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/aide-check
Nice=19
IOSchedulingClass=idle
EOF

cat >/etc/systemd/system/aide-check.timer <<'EOF'
[Unit]
Description=Daily AIDE check

[Timer]
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
EOF

# ---------------------------------------------------------------- auditd
echo "[+] auditd rules"
R=/etc/audit/rules.d/60-devbox.rules
w() { # only if parent dir exists
  if [ -d "$(dirname "$1")" ]; then echo "-w $1 -p $2 -k $3"; fi
}

# Firefox profiles (snap, deb)
ff_rules() {
  local prof d
  for prof in "$H"/snap/firefox/common/.mozilla/firefox/*/ "$H"/.mozilla/firefox/*/; do
    [ -f "$prof/prefs.js" ] || continue
    prof="${prof%/}"
    for d in "$prof"/storage/default/moz-extension+++*; do
      [ -d "$d" ] && echo "-w $d -p rwa -k browser"
    done
    w "$prof/key4.db" rwa browser
    w "$prof/logins.json" rwa browser
    w "$prof/cookies.sqlite" rwa browser
    w "$prof/extensions" wa browser
    w "$prof/user.js" wa browser
  done
}

{
  echo "## generated by sec-setup"
  ff_rules
  w /etc/passwd wa identity
  w /etc/shadow wa identity
  w /etc/group wa identity
  w /etc/gshadow wa identity
  w /etc/sudoers wa priv
  w /etc/sudoers.d wa priv
  w /etc/ssh/sshd_config wa sshd
  w /etc/ssh/sshd_config.d wa sshd
  w /root/.ssh/authorized_keys wa ssh_keys
  w "$H/.ssh/authorized_keys" wa ssh_keys
  w "$H/.ssh/config" wa ssh_keys
  w /etc/systemd/system wa persistence
  w /etc/cron.d wa persistence
  w /etc/crontab wa persistence
  w /var/spool/cron wa persistence
  w "$H/.config/autostart" wa persistence
  w "$H/.config/systemd/user" wa persistence
  # logged only
  echo "-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k kmod"
} >"$R"

cat >/usr/local/sbin/sec-status <<'EOF'
#!/usr/bin/env bash
# collect new audit hits for tmux
S=/var/lib/sec-status
A=$S/audit.alerts
L=$S/audit.last
KEYS='browser|identity|priv|sshd|ssh_keys|persistence'
FF='^(/snap/firefox/[0-9]+/usr/lib/firefox/|/usr/lib/firefox/)'
last=$(cat "$L" 2>/dev/null || echo 0)

new=$(ausearch -m SYSCALL -ts yesterday --raw 2>/dev/null | awk -v last="$last" -v keys="$KEYS" -v ff="$FF" '
  /^type=SYSCALL / && match($0, /msg=audit\([0-9.]+:/) {
    tss = substr($0, RSTART + 10, RLENGTH - 11)
    if (tss + 0 <= last + 0) next
    if (!match($0, /key="[^"]+"/)) next
    k = substr($0, RSTART + 5, RLENGTH - 6)
    if (k !~ ("^(" keys ")$")) next
    exe = "-"
    if (match($0, / exe="[^"]+"/)) exe = substr($0, RSTART + 6, RLENGTH - 7)
    if (k == "browser" && exe ~ ff) next
    print tss, k, exe
  }')

[ -z "$new" ] && exit 0
while read -r ts k exe; do
  printf '%s  %-11s %s\n' "$(date -d "@${ts%.*}" '+%F %T')" "$k" "$exe" >>"$A"
done <<<"$new"
echo "$new" | tail -1 | cut -d' ' -f1 >"$L"
chmod 0644 "$A"
EOF

cat >/usr/local/sbin/sec-ack <<'EOF'
#!/usr/bin/env bash
# show and clear audit alerts
A=/var/lib/sec-status/audit.alerts
if [ -s "$A" ]; then
  cat "$A"
  cat "$A" >>/var/log/sec-alerts-acked.log
fi
: >"$A"
echo "[+] audit alerts cleared"
EOF

cat >/etc/systemd/system/sec-status.service <<'EOF'
[Unit]
Description=Collect auditd alerts for tmux status

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/sec-status
EOF

cat >/etc/systemd/system/sec-status.timer <<'EOF'
[Unit]
Description=Collect auditd alerts every 2 min

[Timer]
OnBootSec=1min
OnUnitActiveSec=2min

[Install]
WantedBy=timers.target
EOF

chmod 0755 /usr/local/sbin/{aide-check,aide-accept,sec-status,sec-ack}
touch "$S/audit.alerts"
chmod 0644 "$S/audit.alerts"

systemctl daemon-reload
systemctl enable --now auditd aide-check.timer sec-status.timer >/dev/null

# baseline last, includes files written above
{
  echo "[+] AIDE baseline (several minutes, idle priority)"
  nice -n 19 ionice -c3 aide -c "$AIDE_CONF" --init >/dev/null
  mv -f /var/lib/aide-local/aide.db.new.gz "$AIDE_DB"
  echo "ok $(date +%F_%H:%M) baseline" >"$S/aide"
  chmod 0644 "$S/aide"
}

augenrules --load >/dev/null
date +%s >"$S/audit.last"

echo "[+] done"
echo "    AIDE CHANGED: sudo less \$(cut -d' ' -f3 $S/aide)  then  sudo aide-accept"
echo "    audit alerts: sudo sec-ack"
